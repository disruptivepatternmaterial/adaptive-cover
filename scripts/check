#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

python3 -m ruff check custom_components scripts/validate_release_metadata.py scripts/validate_runtime_deps.py tests
python3 -m ruff format --check custom_components scripts/validate_release_metadata.py scripts/validate_runtime_deps.py tests
scripts/test
python3 scripts/validate_release_metadata.py
python3 scripts/validate_runtime_deps.py
